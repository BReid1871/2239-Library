# Either a full connection string...
MYSQL_URL=mysql://user:password@host:3306/database

# ...or discrete parts (used if MYSQL_URL / DATABASE_URL aren't set).
# Defaults to 127.0.0.1:3306, user "root", no password, database "library".
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=library

# On Railway, attaching a MySQL plugin to this service injects MYSQL_URL
# (and the discrete MYSQL* vars) automatically — nothing to set by hand.
